PORT=3005

# Optional: SQLite database file (used when DATABASE_URL is not set)
# SQLITE_PATH=./new_minecraft_heads.db

# Optional: PostgreSQL connection (uses SQLite by default)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# TLS certificates are verified by default. If your provider signs with its own
# CA ("self-signed certificate in certificate chain"), point DATABASE_CA_CERT at
# its CA file, or set DATABASE_SSL=no-verify to skip verification.
# "false" connects without TLS.
# DATABASE_CA_CERT=./ca-certificate.crt
# DATABASE_SSL=no-verify

# Optional: per-IP request limit per minute (disabled when unset or 0)
# RATE_LIMIT_PER_MINUTE=120

# Optional: set when running behind a reverse proxy so client IPs are seen
# correctly ("true", a hop count such as 1, or trusted addresses)
# TRUST_PROXY=1
