PORT=3005

# Optional: SQLite database file (used when DATABASE_URL is not set)
# SQLITE_PATH=./new_minecraft_heads.db

# Optional: PostgreSQL connection (uses SQLite by default)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Connections use TLS without certificate verification by default, which works
# with self-signed certificates (Railway, Heroku, ...). Set DATABASE_SSL=verify
# to check the certificate against the system CAs, or DATABASE_CA_CERT to check
# it against your provider's CA file. DATABASE_SSL=false connects without TLS.
# DATABASE_SSL=verify
# DATABASE_CA_CERT=./ca-certificate.crt

# Optional: timeout per request to Mojang, GeyserMC and the texture server
# UPSTREAM_TIMEOUT_MS=10000

# Optional: per-IP request limit per minute (disabled when unset or 0)
# RATE_LIMIT_PER_MINUTE=120

# Optional: set when running behind a reverse proxy so client IPs are seen
# correctly ("true", a hop count such as 1, or trusted addresses)
# TRUST_PROXY=1
